# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). See supabase/README.md.
#
# .env.local is gitignored. Keep it that way.

# Safe to expose — it ships to the browser, and the row level security policies
# in supabase/schema.sql decide what it is allowed to do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT safe to expose. Bypasses row level security entirely. Used only by
# scripts/seed-content.mjs, on your machine. It does not belong in Vercel, and
# it must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
