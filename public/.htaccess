# TDM static site — Apache config (used if hosted on cPanel/Apache).
# On Vercel/Netlify this file is ignored; use deploy/vercel.json instead.

Options -Indexes
ErrorDocument 404 /404.html

# ---------- 301 redirects from the old WordPress site ----------
Redirect 301 /search-engine-optimization-services/ /marketing/seo/
Redirect 301 /technical-seo-services/ /marketing/seo/
Redirect 301 /on-page-seo/ /marketing/seo/
Redirect 301 /off-page-seo/ /marketing/seo/
