Redirect 301 /website-development-services/ /development/
Redirect 301 /mobile-app-development-services/android-app-development-services/ /development/mobile-apps/
Redirect 301 /mobile-app-development-services/ios-app-development-services/ /development/mobile-apps/
Redirect 301 /mobile-app-development-services/ /development/mobile-apps/
Redirect 301 /media-and-designing-services/video-editing-services/ /media/video-editing/
